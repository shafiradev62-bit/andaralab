# Vercel Environment Variables for AndaraLab
# Copy these to Vercel Project Settings > Environment Variables

# Backend API Configuration
# Set to VPS URL to ensure frontend hits backend on VPS
VITE_API_BASE_URL=http://76.13.17.91:3001/api
VITE_API_FALLBACK_BASE_URL=http://76.13.17.91:3001/api
VITE_ALLOW_API_FALLBACK=true

# Deploy webhook secret (optional)
VITE_DEPLOY_SECRET=andara-secret-key

# AWS S3 Configuration (optional - for frontend S3 sync)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=andaralab-data-backup
AWS_S3_PREFIX=andaralab-data
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_S3_SYNC_ENABLED=false
