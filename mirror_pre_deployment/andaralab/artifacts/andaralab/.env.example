# ── AWS S3 Sync ──────────────────────────────────────────────────────────────
# Set these on the VPS to enable continuous data backup to S3.
# Every time data is saved (dataset create/update/delete, calendar, etc.),
# it's automatically uploaded to S3. On server restart, missing files are
# restored from S3 automatically.
#
# HOW TO SET UP:
# 1. Create an S3 bucket in AWS Console (e.g. andaralab-data-backup)
# 2. Create an IAM user with these permissions on the bucket:
#    - s3:PutObject
#    - s3:GetObject
#    - s3:ListBucket  (optional, for debugging)
# 3. Generate Access Key for the IAM user
# 4. Fill in the values below and copy to /root/andaralab/.env on the VPS

AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=andaralab-data-backup
AWS_S3_PREFIX=andaralab-data
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_SYNC_ENABLED=true

# Frontend safety toggle:
# Keep this false so frontend does NOT silently fall back to stale seed data.
# Set to true only for offline/demo mode.
VITE_ALLOW_API_FALLBACK=false

# ── Other settings ────────────────────────────────────────────────────────────
DEPLOY_WEBHOOK_SECRET=your-webhook-secret-here
